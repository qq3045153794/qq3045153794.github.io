---
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import TOC from "@/components/blog/TOC.astro";
import {
	formatRating,
	noteKindLabels,
	readingFormatLabels,
	readingStatusLabels,
	type NoteKind,
	type ReadingFormat,
	type ReadingStatus,
} from "@/utils/note";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	note: CollectionEntry<"note">;
	isPreview?: boolean | undefined;
};

const { as: Tag = "div", note, isPreview = false } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(note);
const data = note.data;
const richNote = data.kind === "reading" || data.kind === "video";
const readingTime: string = remarkPluginFrontmatter.readingTime;
const dateTimeOptions: Intl.DateTimeFormatOptions | undefined = richNote
	? undefined
	: { hour: "2-digit", minute: "2-digit", year: "2-digit", month: "2-digit", day: "2-digit" };
const kindLabel = noteKindLabels[data.kind as NoteKind];
---

<article
	class:list={[isPreview && "bg-global-text/5 inline-grid rounded-md px-4 py-3"]}
	data-pagefind-body={isPreview ? false : true}
>
	{data.draft && <span class="text-red-500">(草稿)</span>}

	{!isPreview && data.coverImage && (
		<Image
			alt={data.coverImage.alt}
			class="mb-6 max-h-96 rounded object-cover"
			layout="constrained"
			src={data.coverImage.src}
		/>
	)}

	<div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-muted">
		<span class="rounded border border-current px-2 py-1">{kindLabel}</span>
		{data.format && (
			<span class="rounded border border-current px-2 py-1">
				{readingFormatLabels[data.format as ReadingFormat]}
			</span>
		)}
		{data.status && (
			<span class="rounded border border-current px-2 py-1">
				{readingStatusLabels[data.status as ReadingStatus]}
			</span>
		)}
		{data.rating && <span>{formatRating(data.rating)}</span>}
		<FormattedDate
			{...(dateTimeOptions ? { dateTimeOptions } : {})}
			date={data.publishDate}
		/>
	</div>

	<Tag class="title" class:list={{ "text-base": isPreview }}>
		{
			isPreview ? (
				<a class="cactus-link" href={`/notes/${note.id}/`}>
					{data.title}
				</a>
			) : (
				<>{data.title}</>
			)
		}
	</Tag>

	{!isPreview && (
		<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 font-semibold">
			<span>/ {readingTime}</span>
			{data.author && <span>作者：{data.author}</span>}
			{data.sourceURL && (
				<a class="cactus-link" href={data.sourceURL} rel="noreferrer" target="_blank">来源</a>
			)}
		</div>
	)}

	{isPreview ? (
		data.description ? (
			<p class="mt-3 line-clamp-4 text-muted">{data.description}</p>
		) : (
			<div class="prose prose-sm prose-cactus mt-4 line-clamp-6 max-w-none [&>p:last-of-type]:mb-0">
				<Content />
			</div>
		)
	) : (
		<div class="mt-8 flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
			{headings.length > 0 && <TOC headings={headings} />}
			<div class="prose prose-sm prose-cactus max-w-none">
				<Content />
			</div>
		</div>
	)}

	{!isPreview && data.tags.length > 0 && (
		<div class="mt-8 flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted">
			{data.tags.map((tag: string) => (
				<a class="cactus-link before:content-['#']" href={`/tags/${tag}/`}>{tag}</a>
			))}
		</div>
	)}
</article>
