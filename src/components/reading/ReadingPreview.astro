---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import { formatRating, readingFormatLabels, readingStatusLabels } from "@/utils/reading";

type ReadingFormat = keyof typeof readingFormatLabels;
type ReadingStatus = keyof typeof readingStatusLabels;

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	reading: CollectionEntry<"reading">;
	withDesc?: boolean;
};

const { as: Tag = "div", reading, withDesc = false } = Astro.props;
const { data } = reading;
---

<FormattedDate class="text-muted min-w-30 font-semibold" date={data.publishDate} />
<Tag class="flex flex-wrap items-baseline gap-2">
	<span class="rounded border border-current px-1.5 py-0.5 text-xs text-muted">
		{readingFormatLabels[data.format as ReadingFormat]} ·{" "}
		{readingStatusLabels[data.status as ReadingStatus]}
	</span>
	<a class="cactus-link" href={`/reading/${reading.id}/`}>{data.title}</a>
	{data.rating && <span class="text-sm text-amber-600 dark:text-amber-400">{formatRating(data.rating)}</span>}
</Tag>
{withDesc && <q class="line-clamp-3 text-muted italic">{data.description}</q>}
