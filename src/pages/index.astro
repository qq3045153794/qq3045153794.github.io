---
import PostPreview from "@/components/blog/PostPreview.astro";
import Note from "@/components/note/Note.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllNotes, getAllPosts } from "@/data/content";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const [allPosts, allNotes] = await Promise.all([getAllPosts(), getAllNotes()]);
const latestPosts = allPosts.sort(collectionDateSort).slice(0, 6);
const pinnedPosts = latestPosts.filter((post) => post.data.pinned).slice(0, 3);
const latestNotes = allNotes.sort(collectionDateSort).slice(0, 8);
---

<PageLayout meta={{ title: "首页" }}>
	<section>
		<h1 class="title mb-6">你好，我是 Saber。</h1>
		<p class="mb-4 leading-7">
			这里记录技术文章和学习笔记，包括读书笔记、视频笔记、TIL 和随想。内容以 Markdown 保存在 GitHub，
			通过 Astro 构建并发布到 GitHub Pages。
		</p>
		<p class="mb-4 leading-7 text-muted">
			我会让 Hermes 参与资料整理、提纲、草稿和润色，但所有内容都通过分支和 Pull Request 审阅后再发布。
		</p>
		<SocialList />
	</section>

	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">置顶文章</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((post) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={post} />
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/posts/">最新文章</a></h2>
		<ul class="space-y-4" role="list">
			{latestPosts.map((post) => (
				<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
					<PostPreview post={post} />
				</li>
			))}
		</ul>
	</section>

	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl"><a href="/notes/">最新笔记</a></h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li><Note note={note} as="h3" isPreview /></li>
					))}
				</ul>
			</section>
		)
	}

</PageLayout>
