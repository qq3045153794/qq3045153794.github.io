---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";
import ContentPreview from "@/components/content/ContentPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllContent, getTagMeta, getUniqueTagsWithCount } from "@/data/content";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async ({ paginate }) => {
	const allContent = await getAllContent();
	const uniqueTags = getUniqueTagsWithCount(allContent).map(([tag]) => tag);

	return uniqueTags.flatMap((tag) => {
		const items = allContent.filter((item) => item.tags.includes(tag));
		return paginate(items, { pageSize: 12, params: { tag } });
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const { tag } = Astro.params;
const tagMeta = await getTagMeta(tag);
const TagContent = tagMeta ? (await render(tagMeta)).Content : null;
const meta = {
	description: tagMeta?.data.description ?? `包含标签 ${tag} 的文章和笔记`,
	title: tagMeta?.data.title ?? `标签：${tag}`,
};
const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← 上一页", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "下一页 →", url: page.url.next } }),
};
---

<PageLayout meta={meta}>
	<nav class="mb-8" aria-label="面包屑">
		<ul class="flex items-center">
			<li class="flex items-center">
				<a class="text-accent" href="/tags/">标签</a>
				<Icon aria-hidden="true" name="mdi:chevron-right" class="mx-1.5" />
			</li>
			<li aria-current="page"><span aria-hidden="true">#</span>{tag}</li>
		</ul>
	</nav>
	<h1 class="title">{tagMeta?.data.title ?? `标签：${tag}`}</h1>
	<div class="prose prose-sm prose-cactus mb-12 mt-4 max-w-none">
		{tagMeta?.data.description && <p>{tagMeta.data.description}</p>}
		{TagContent && <TagContent />}
	</div>
	<ul class="space-y-5">
		{
			page.data.map((item) => (
				<li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
					<ContentPreview item={item} withDesc />
				</li>
			))
		}
	</ul>
	<Pagination {...paginationProps} />
</PageLayout>
