---
import { getAllContent, getUniqueTagsWithCount } from "@/data/content";
import PageLayout from "@/layouts/Base.astro";

const allContent = await getAllContent();
const allTags = getUniqueTagsWithCount(allContent);
const meta = {
	description: "文章和笔记中的全部标签",
	title: "标签",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-4">标签</h1>
	<p class="mb-10 text-muted">标签会聚合文章和各类笔记。</p>
	<ul class="space-y-4">
		{
			allTags.map(([tag, count]) => (
				<li class="flex items-center gap-x-2">
					<a class="cactus-link inline-block" href={`/tags/${tag}/`} title={`查看标签：${tag}`}>
						#{tag}
					</a>
					<span class="text-muted">— {count} 篇</span>
				</li>
			))
		}
	</ul>
</PageLayout>
