---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getAllNotes } from "@/data/content";

export const getStaticPaths = (async () => {
	const notes = await getAllNotes();
	return notes
		.filter((note) => note.data.kind === "reading" || note.data.kind === "video")
		.map((note) => ({
			params: { slug: note.id },
			props: { noteId: note.id },
		}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { noteId } = Astro.props;
const target = `/notes/${noteId}/`;
const canonical = new URL(target, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta content={`0; url=${target}`} http-equiv="refresh" />
		<link href={canonical} rel="canonical" />
		<meta content="noindex" name="robots" />
		<title>笔记已迁移</title>
	</head>
	<body>
		<p>这篇笔记已迁移到 <a href={target}>新地址</a>。</p>
	</body>
</html>
