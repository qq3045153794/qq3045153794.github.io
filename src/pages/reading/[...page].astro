---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import Pagination from "@/components/Paginator.astro";
import ReadingPreview from "@/components/reading/ReadingPreview.astro";
import { getAllReadings } from "@/data/content";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const readings = await getAllReadings();
	return paginate(readings.sort(collectionDateSort), { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"reading">>;
}

const { page } = Astro.props;
const meta = {
	description: "书籍、论文、文章和课程的学习笔记",
	title: "读书笔记",
};
const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← 上一页", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "下一页 →", url: page.url.next } }),
};
---

<PageLayout meta={meta}>
	<section>
		<h1 class="title mb-4 flex items-center gap-3">
			读书笔记
			<a class="text-accent" href="/reading/rss.xml" target="_blank">
				<span class="sr-only">RSS feed</span>
				<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
			</a>
		</h1>
		<p class="mb-12 text-muted">记录书、论文、文章和课程里值得留下来的内容。</p>
		<ul class="space-y-6">
			{
				page.data.map((reading) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
						<ReadingPreview reading={reading} withDesc />
					</li>
				))
			}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
