---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import Note from "@/components/note/Note.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllNotes } from "@/data/content";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const notes = await getAllNotes();
	return paginate(notes.sort(collectionDateSort), { pageSize: 12 });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"note">>;
}

const { page } = Astro.props;
const meta = {
	description: "学习笔记、读书笔记、视频笔记和日常记录",
	title: "笔记",
};
const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← 上一页", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "下一页 →", url: page.url.next } }),
};
---

<PageLayout meta={meta}>
	<section>
		<h1 class="title mb-4 flex items-center gap-3">
			笔记
			<a class="text-accent" href="/notes/rss.xml" target="_blank">
				<span class="sr-only">RSS feed</span>
				<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="mdi:rss" />
			</a>
		</h1>
		<p class="mb-12 text-muted">统一收录学习笔记、读书笔记、视频笔记、TIL、摘录和随想。</p>
		<ul class="space-y-8 text-start">
			{
				page.data.map((note) => (
					<li><Note note={note} as="h2" isPreview /></li>
				))
			}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
