---
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";
import TOC from "@/components/blog/TOC.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { githubEditUrl } from "@/utils/github";
import { formatRating, readingFormatLabels, readingStatusLabels } from "@/utils/reading";
import BaseLayout from "./Base.astro";

interface Props {
	reading: CollectionEntry<"reading">;
}

const { reading } = Astro.props;
const {
	author,
	coverImage,
	description,
	format,
	ogImage,
	publishDate,
	rating,
	sourceURL,
	status,
	tags,
	title,
	updatedDate,
} = reading.data;
const socialImage = ogImage ?? `/og-image/reading/${reading.id}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(reading);
const readingTime: string = remarkPluginFrontmatter.readingTime;
---

<BaseLayout meta={{ articleDate, description, ogImage: socialImage, title }}>
	<article class="grow break-words" data-pagefind-body>
		<header class="mb-12" id="reading-hero">
			{coverImage && (
				<Image
					alt={coverImage.alt}
					class="mb-6 max-h-96 rounded object-cover"
					layout="constrained"
					src={coverImage.src}
				/>
			)}
			<div class="mb-3 flex flex-wrap gap-2 text-xs text-muted">
				<span class="rounded border border-current px-2 py-1">{readingFormatLabels[format]}</span>
				<span class="rounded border border-current px-2 py-1">{readingStatusLabels[status]}</span>
				{rating && <span class="rounded border border-current px-2 py-1">{formatRating(rating)}</span>}
			</div>
			<h1 class="title">{title}</h1>
			<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 font-semibold">
				<FormattedDate date={publishDate} />
				<span>/ {readingTime}</span>
				{author && <span>作者：{author}</span>}
				{sourceURL && (
					<a class="cactus-link" href={sourceURL} rel="noreferrer" target="_blank">来源</a>
				)}
			</div>
			{updatedDate && (
				<p class="mt-2 text-muted">最后更新：<FormattedDate date={updatedDate} /></p>
			)}
			{tags.length > 0 && (
				<div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-muted">
					{tags.map((tag) => (
						<a class="cactus-link before:content-['#']" href={`/tags/${tag}/`}>{tag}</a>
					))}
				</div>
			)}
		</header>
		<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:justify-between">
			{headings.length > 0 && <TOC headings={headings} />}
			<div class="prose prose-sm prose-headings:font-semibold prose-headings:text-accent-2 max-w-none">
				<slot />
				<hr />
				<p class="text-sm text-muted">
					<a class="cactus-link" href={githubEditUrl("reading", reading.id)}>在 GitHub 上编辑这篇读书笔记</a>
				</p>
			</div>
		</div>
	</article>
</BaseLayout>
